rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }

    match /avatars/{uid}/{file=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024;
    }

    match /outputs/{uid}/{file=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid && request.resource.size < 50 * 1024 * 1024;
    }

    match /blog/{file=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
